<!doctype html>
<html lang="en">
	<%- include('partials/metadata', locals.title) %>
	<body>
		<div id="root" class="grid">
			<%- include('partials/navbar') %>
			<main class="flex flex-col gap-m max-w mx-auto p-m w-full">
				<% if (locals.user == null) { %>
					<%- include('partials/alert', {
						children: `
							<p class="text-center">
								<a href="/log-in">Log into an existing account</a>
								to create posts.
							</p>
						`,
					}) %>
				<% } else { %>
					<p class="color-content fs-xl fw-bold text-center">
						Welcome, <%= user.full_name %>!
					</p>

					<% if (!user.is_member) { %>
						<%- include('partials/alert', {
							children: `
								<p class="text-center">
									<a href="/join-the-club">Join the club</a>
									to see usernames and dates.
								</p>
							`,
						}) %>
        	<% } %>

					<% if (user.is_admin) { %>
						<%- include('partials/alert', {
							level: 'admin',
							children: '<p class="text-center">You are an admin.</p>',
						}) %>
        	<% } %>
				<% } %>

				<ul class="flex flex-col gap-m">
					<% for (const post of posts) { %>
						<li><%- include('partials/post', { post }) %></li>
					<% } %>
				</ul>
			</main>
			<%- include('partials/footer') %>
		</div>
	</body>
</html>
